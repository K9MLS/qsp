// Lets QSP start, stop and restart the vocoder dongle's AMBEserver service from
// the console's Zello page, and clear its failed state — that one unit, those
// four verbs, the qsp user, and nothing else. QSP stays unprivileged; without this file its buttons say
// "not authorized" and nothing else changes.
//
// Install: sudo cp 50-qsp-ambeserver.rules /etc/polkit-1/rules.d/
// polkit reads it immediately; no restart is needed.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.user !== "qsp" || action.lookup("unit") !== "ambeserver.service") {
        return polkit.Result.NOT_HANDLED;
    }
    var verb = action.lookup("verb");
    // reset-failed clears a tripped start limit: the page's "Reset and start".
    if (verb === "start" || verb === "stop" || verb === "restart" || verb === "reset-failed") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
